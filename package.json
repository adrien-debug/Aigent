{
  "name": "agent-mission-control",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file=.env.local scripts/dev-stack.mjs",
    "dev:stack": "node --env-file=.env.local scripts/dev-stack.mjs",
    "dev:legacy": "concurrently -k --kill-others-on-fail -n next,langgraph -c blue,magenta \"npm:dev:next\" \"npm:langgraph\"",
    "health": "node --env-file=.env.local scripts/health.mjs",
    "dev:clean": "rm -rf .next && npm run dev:stack",
    "dev:next": "next dev",
    "langgraph": "langgraphjs dev --no-browser --host 127.0.0.1 --port 2024 --n-jobs-per-worker 2",
    "langgraph:studio": "open 'https://smith.langchain.com/studio/?baseUrl=http://127.0.0.1:2024'",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:ds": "node scripts/check-palette.mjs",
    "check:catalyst": "node scripts/check-catalyst.mjs",
    "check:legacy-bridge": "node scripts/check-legacy-bridge.mjs",
    "check:views": "node scripts/check-views.mjs",
    "check:agent-truth": "node scripts/check-agent-truth.mjs",
    "check:danger": "node scripts/check-danger-role.mjs",
    "check:render-truth": "node scripts/check-render-truth.mjs",
    "check:status-truth": "node scripts/check-status-truth.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:registry-parity": "node scripts/check-registry-parity.mjs",
    "check:registry-integrity": "node scripts/check-registry-integrity.mjs",
    "check:tool-rows": "node --env-file-if-exists=.env.local scripts/check-tool-rows-drift.mjs",
    "check:charts": "node scripts/check-charts.mjs",
    "check:rsc-boundary": "node scripts/check-rsc-boundary.mjs",
    "check": "npm run typecheck && npm run lint:fast && npm run lint && npm run check:ds && npm run check:catalyst && npm run check:legacy-bridge && npm run check:views && npm run check:agent-truth && npm run check:danger && npm run check:render-truth && npm run check:status-truth && npm run check:registry-parity && npm run check:registry-integrity && npm run check:tool-rows && npm run check:charts && npm run check:rsc-boundary && npm run check:secrets && npm run audit:dead",
    "audit:dead": "node scripts/audit-dead.mjs",
    "verify": "npm run check && npm run audit:dead && npm run test && npm run build",
    "eval:trading": "node --env-file=.env.local $(command -v npx) -y tsx scripts/eval-trading-roster.ts",
    "materialize:trading": "node --env-file=.env.local $(command -v npx) -y tsx scripts/materialize-trading-roster.ts",
    "improve:trading-v2": "node --env-file=.env.local $(command -v npx) -y tsx scripts/improve-trading-v2.ts",
    "persist:trading-scores": "node --env-file=.env.local $(command -v npx) -y tsx scripts/persist-trading-scores.ts",
    "seed:amc": "node --env-file=.env.local $(command -v npx) -y tsx scripts/seed-amc.ts",
    "smoke:atlas": "node --env-file=.env.local $(command -v npx) -y tsx scripts/smoke-run-atlas.ts",
    "update:trading-tool-descriptions": "node --env-file=.env.local $(command -v npx) -y tsx --conditions=react-server scripts/update-trading-tool-descriptions.ts",
    "reprovision": "node --env-file=.env.local $(command -v npx) -y tsx --conditions=react-server scripts/reprovision-assistants.ts",
    "provision:agent-builder": "node --env-file=.env.local $(command -v npx) -y tsx scripts/provision-agent-builder.ts",
    "test": "vitest run tests/unit",
    "test:live": "vitest run tests/live",
    "export:trading": "node scripts/export-trading-packages.mjs",
    "verify:admin-routes": "node scripts/verify-admin-route-surface.mjs",
    "lint:fast": "oxlint src",
    "check:secrets": "gitleaks git --no-banner --redact --config .gitleaks.toml",
    "hooks:install": "git config core.hooksPath scripts/hooks && echo '✓ pre-commit gitleaks actif (core.hooksPath=scripts/hooks)'",
    "quality:dead": "knip",
    "quality:dup": "jscpd src --threshold 100 --reporters consoleFull"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@langchain/core": "^1.2.2",
    "@langchain/langgraph": "^1.4.7",
    "@langchain/langgraph-cli": "^1.4.2",
    "@langchain/langgraph-sdk": "^1.9.25",
    "@langchain/openai": "^1.5.5",
    "@xyflow/react": "^12.11.2",
    "clsx": "^2.1.1",
    "motion": "^12.42.2",
    "next": "16.2.10",
    "openai": "^6.46.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "happy-dom": "^20.11.0",
    "jscpd": "^5.0.12",
    "knip": "^6.29.0",
    "oxlint": "^1.75.0",
    "playwright": "^1.52.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
