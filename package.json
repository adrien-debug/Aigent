{
  "name": "agent-mission-control",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k --kill-others-on-fail -n next,langgraph -c blue,magenta \"npm:dev:next\" \"npm:langgraph\"",
    "dev:next": "next dev",
    "langgraph": "langgraphjs dev --no-browser --host 127.0.0.1 --port 2024",
    "langgraph:studio": "open 'https://smith.langchain.com/studio/?baseUrl=http://127.0.0.1:2024'",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:ds": "node scripts/check-palette.mjs",
    "check:catalyst": "node scripts/check-catalyst.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:ds && npm run check:catalyst",
    "verify": "npm run typecheck && npm run lint && npm run check:ds && npm run check:catalyst && npm run test && npm run build",
    "reprovision": "node --env-file=.env.local $(command -v npx) -y tsx --conditions=react-server scripts/reprovision-assistants.ts",
    "test": "vitest run tests/unit",
    "test:live": "vitest run tests/live"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@langchain/core": "^1.2.2",
    "@langchain/langgraph": "^1.4.7",
    "@langchain/langgraph-cli": "^1.4.2",
    "@langchain/langgraph-sdk": "^1.9.25",
    "@langchain/openai": "^1.5.5",
    "clsx": "^2.1.1",
    "motion": "^12.42.2",
    "next": "16.2.10",
    "openai": "^6.46.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.2",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
