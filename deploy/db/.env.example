# deploy/db/.env — secrets for the Aigent data layer on gpu1.
# Copy to deploy/db/.env (git-ignored, chmod 600) and fill in. NEVER commit .env.

# Password of the authenticator_aigent role on nexus-postgres (gpu1).
# Same value baked into the current aigent-postgrest container's PGRST_DB_URI.
PGRST_DB_PASSWORD=

# JWT signing secret. MUST be identical to the app's (deploy/app/.env,
# used to mint the service-role / anon tokens) — otherwise every request is
# rejected with a 401. Same value as the current container's PGRST_JWT_SECRET.
JWT_SECRET=
