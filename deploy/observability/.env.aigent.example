# Variables à ajouter à .env.local pour brancher la console d'outillage
# sur la stack locale. Valeurs d'exemple — adapter aux ports réels.
LANGFUSE_HOST=http://127.0.0.1:3801
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxx
LANGFUSE_BASEURL=http://127.0.0.1:3801
GRAFANA_URL=http://127.0.0.1:3802
N8N_URL=http://127.0.0.1:3803
PROMETHEUS_URL=http://127.0.0.1:3804
