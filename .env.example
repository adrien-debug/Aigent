# Agent Mission Control — server-side env. Copy to .env.local and fill in.
# NOTHING here is exposed to the browser (no NEXT_PUBLIC_*). Never commit real values.

# --- Live data backend (gpu1 PostgREST perimeter) ---
AMC_DATA_SOURCE=gpu1
# Public HTTPS via Cloudflare tunnel hearst-prod: https://aigent-db.hearst.app
# (fallback Tailscale direct http://100.88.191.49:8095 only if the tunnel is down).
AMC_SUPABASE_URL=            # PostgREST base URL — https://aigent-db.hearst.app
SUPABASE_SERVICE_ROLE_KEY=   # service_role key (RLS-bypassing) — server only

# --- Model providers (fail-closed: absent → that provider is unavailable) ---
OPENAI_API_KEY=              # enables the openai route in the model router (gpt-5.4)
# GEMINI_API_KEY=            # optional; enables the google route
# GOOGLE_API_KEY=            # optional; alias fallback for GEMINI_API_KEY (model router reads either)
# AMC_ALLOW_MODEL_FALLBACKS= # optional; 1 = allow the router to fall back to a secondary model

# --- Local vLLM park (provider 'local', model-local.ts) ---
# Opt-in only: a copilot must select modelProvider 'local' AND one of the ids
# local-reasoning-70b / local-llama-70b / local-qwen-32b / local-qwen-7b.
# Fail-closed per endpoint: the shared key + that endpoint's
# URL must both be set, otherwise the standard fallback policy applies.
# VLLM_LOCAL_API_KEY=            # shared bearer key of the vLLM park (vllm-local-key)
# VLLM_GPU1_REASONING_URL=       # http://192.168.1.200:8003/v1 — DeepSeek R1 distill 70B (ctx 8192)
# VLLM_GPU2_LLAMA_URL=           # http://100.110.74.114:8003/v1 — Llama 3.3 70B (vllm-hearst, ctx 8192)
# VLLM_GPU1_QWEN32_URL=          # http://192.168.1.200:8000/v1 — Qwen2.5 Coder 32B (ctx 16384)
# VLLM_GPU1_QWEN7_URL=           # http://192.168.1.200:8001/v1 — Qwen2.5 Coder 7B (ctx 8192)
# Optional per-endpoint override of the upstream model id sent to vLLM (defaults
# in model-local.ts; needed mainly for GPU2 llama, whose served id is a HF
# snapshot path that changes on redeploy):
# VLLM_GPU1_REASONING_MODEL=
# VLLM_GPU2_LLAMA_MODEL=
# VLLM_GPU1_QWEN32_MODEL=
# VLLM_GPU1_QWEN7_MODEL=

# --- GitHub (read proxy + agent scaffolding) ---
GITHUB_TOKEN=
# GITHUB_PUSH_ENABLED=1      # optional; required (with confirm) for a REAL agent push

# --- Admin identity gate ---
# REQUIRED in EVERY environment (dev included): there is no fallback secret and
# no fallback admin password. Without these two, /api/auth/login answers 503 and
# no session can be minted or trusted. Min 16 chars; generate a strong one:
#   openssl rand -hex 32
#   (or) node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AMC_SESSION_SECRET=
# The admin password. Prefer the HASH var over the plain one. REQUIRED (this or
# AMC_ADMIN_PASSWORD_HASH) — absent means every login attempt is refused.
AMC_ADMIN_PASSWORD=
# Preferred: sha256 hex of the password (wins over the plain var). Generate:
#   node -e "console.log(require('crypto').createHash('sha256').update('YOUR_PASSWORD').digest('hex'))"
# AMC_ADMIN_PASSWORD_HASH=
# Optional server-to-server / automation key (sent as header x-amc-key).
AMC_API_KEY=

# --- LangGraph Agent Server (langgraphjs) ---
# Local dev: http://127.0.0.1:2024 (default, started alongside `next dev`).
# Production: the deployed server, e.g. https://agent.hearst.app
# LANGGRAPH_API_URL=
# Model the agent_builder graph binds. Optional, defaults to gpt-5.4.
# AGENT_BUILDER_MODEL=
# Shared secret the app sends (header x-agent-key) to authenticate against the
# Agent Server. Required in BOTH local dev (the local langgraphjs dev server is
# fail-closed) and production — left uncommented like the other required vars.
# Set the same value on the app side and the server side.
LANGGRAPH_SERVER_SECRET=
# Custom runtime endpoint (github.ts): point AGENT_ENDPOINT at your own
# inference service to push agents there instead of LangGraph. Optional
# AGENT_API_KEY is forwarded as auth if your service expects one.
# AGENT_ENDPOINT=
# AGENT_API_KEY=

# --- Runtime telemetry ingestion (opt-in, best-effort from generated agents) ---
# Bearer token generated agent handlers use to POST /api/runtime-telemetry.
# Absent → the endpoint returns 503 (ingestion disabled). Never AMC_API_KEY.
AIGENT_RUNTIME_TELEMETRY_TOKEN=

# --- LangSmith tracing (optional; absent → no-op, traceUrl stays null) ---
# LANGSMITH_API_KEY=
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_PROJECT=agent-mission-control
# LANGSMITH_TRACE_BASE_URL=  # deep-link base; only this yields a clickable traceUrl

# --- Langfuse tracing (optional; absent → langfuse client stays no-op) ---
# LANGFUSE_HOST=       # e.g. https://cloud.langfuse.com or self-hosted base URL
# LANGFUSE_PUBLIC_KEY= # Langfuse project public key
# LANGFUSE_SECRET_KEY= # Langfuse project secret key — server only

# --- Runtime telemetry API (Aigent-side ingestion auth for delivered agents) ---
# Bearer token expected on inbound runtime-api requests from delivered agents (runtime-api-types.ts). Optional; absent → that check is skipped.
# AIGENT_RUNTIME_API_TOKEN=

# --- Consumer-side telemetry opt-in (lives in DELIVERED agent packages, not Aigent itself) ---
# consumer-bootstrap.ts reads these on the consumer/runtime side of the delivered agent, not in the Aigent server process.
# AIGENT_TELEMETRY_ENABLED=true   # optional; 'true' turns on the consumer's telemetry POSTs
# AIGENT_TELEMETRY_ENDPOINT=      # optional; URL the consumer posts telemetry events to
# AIGENT_TELEMETRY_TOKEN=         # optional; bearer token the consumer sends (paired with AIGENT_RUNTIME_TELEMETRY_TOKEN above)
# AIGENT_PROJECT_KEY=             # optional; project identifier stamped on outgoing telemetry events, defaults to 'unknown'

# --- Consumer feedback channel, PER-INSTALLATION identity (migration 0045) ---
# These live in the CONSUMER's environment, never in Aigent's. Read by
# consumerIdentityFromEnv() in consumer-telemetry-emitter.ts, which returns null
# (and emits nothing) if any of them is missing — no partial identity is invented.
#
# AIGENT_INSTALLATION_TOKEN is a FOURTH identity: one token PER installation and
# per environment, minted by Aigent and stored only as a SHA-256 hash. It shares
# no value with AMC_API_KEY, AIGENT_RUNTIME_TELEMETRY_TOKEN or
# AIGENT_RUNTIME_API_TOKEN. A staging token cannot report production activity.
# AIGENT_INSTALLATION_TOKEN=      # per-installation secret; never logged, never reused across environments
# AIGENT_INSTALLATION_ID=         # installation identity the token is bound to
# AIGENT_COPILOT_ID=              # copilot this installation may report for
# AIGENT_VERSION_ID=              # version the consumer is running
# AIGENT_PROJECT_ID=              # project the copilot belongs to
# AIGENT_ENVIRONMENT=production   # production | staging | development

# --- Trading Agent Factory (read-only market data, ETH-only universe) ---
# TRADEAGENT_MARKET_URL=   # base URL of TradeAgent's public /api/market/* routes; absent → market tools report UNAVAILABLE
# TRADEAGENT_PORTFOLIO_RISK_URL=  # base URL of TradeAgent internal /api/internal/portfolio-risk route (no trailing slash)
# TRADEAGENT_INTERNAL_API_KEY=    # shared key for TradeAgent internal portfolio-risk route (header x-tradeagent-internal-key)
# TRADEAGENT_ACCOUNT_RISK_SNAPSHOTS_JSON=  # dev fallback array when portfolio-risk route is unavailable
# AIG_MARKET_FIXTURE=      # optional dev-only scenario id to force a fixture snapshot instead of live data

# --- Export / provisioning scripts (scripts/*, not read by the app server) ---
# AIG_PACK_SNAPSHOT=    # optional override path for the frozen db-truth.json snapshot used by export:trading
# REPROVISION_STRICT=1  # optional; same effect as --strict on scripts/reprovision-assistants.ts
