# Agent Mission Control — server-side env. Copy to .env.local and fill in.
# NOTHING here is exposed to the browser (no NEXT_PUBLIC_*). Never commit real values.

# --- Live data backend (gpu1 PostgREST perimeter) ---
AMC_DATA_SOURCE=gpu1
AMC_SUPABASE_URL=            # private PostgREST base URL
SUPABASE_SERVICE_ROLE_KEY=   # service_role key (RLS-bypassing) — server only

# --- Model providers (fail-closed: absent → that provider is unavailable) ---
OPENAI_API_KEY=              # enables the openai route in the model router (gpt-5.4)
# GEMINI_API_KEY=            # optional; enables the google route

# --- GitHub (read proxy + agent scaffolding) ---
GITHUB_TOKEN=
# GITHUB_PUSH_ENABLED=1      # optional; required (with confirm) for a REAL agent push

# --- Admin identity gate (PROMPT 12) ---
# Session cookie signing key. REQUIRED for auth. Generate a strong one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AMC_SESSION_SECRET=
# The admin password. Prefer the HASH var over the plain one.
AMC_ADMIN_PASSWORD=
# Preferred: sha256 hex of the password (wins over the plain var). Generate:
#   node -e "console.log(require('crypto').createHash('sha256').update('YOUR_PASSWORD').digest('hex'))"
# AMC_ADMIN_PASSWORD_HASH=
# Optional server-to-server / automation key (sent as header x-amc-key).
AMC_API_KEY=

# --- LangGraph Agent Server (langgraphjs) ---
# Local dev: http://127.0.0.1:2024 (default, started alongside `next dev`).
# Production: the deployed server, e.g. https://agent.hearst.app
# LANGGRAPH_API_URL=
# Shared secret the app sends (header x-agent-key) to authenticate against the
# Agent Server. Required in BOTH local dev (the local langgraphjs dev server is
# fail-closed) and production — left uncommented like the other required vars.
# Set the same value on the app side and the server side.
LANGGRAPH_SERVER_SECRET=

# --- LangSmith tracing (optional; absent → no-op, traceUrl stays null) ---
# LANGSMITH_API_KEY=
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_PROJECT=agent-mission-control
# LANGSMITH_TRACE_BASE_URL=  # deep-link base; only this yields a clickable traceUrl
