{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/*.{ts,tsx}",
    "src/langgraph/**/*.mjs",
    "scripts/**/*.{ts,mjs,js}",
    "tests/**/*.{ts,tsx}",
    "langgraph.json"
  ],
  "project": ["src/**/*.{ts,tsx,mjs}", "scripts/**/*.{ts,mjs,js}", "tests/**/*.{ts,tsx}"],
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["gitleaks"],
  "ignore": [
    "src/components/ui/**",
    "src/lib/agent-mission-control/consumer-telemetry-emitter.ts"
  ],
  "ignoreIssues": {
    "src/lib/agent-mission-control/consumer-installations.ts": ["exports"]
  },
  "ignoreDependencies": ["tailwindcss", "motion"]
}

