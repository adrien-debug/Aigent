# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.tmp/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the example template (no real secrets) is committed as documentation.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright MCP artifacts + ad-hoc screenshots
.playwright-mcp/
/*.png

# LangGraph API
.langgraph_api
.sweep/

# Scratch — dumps, screenshots, ad-hoc working files (rm -rf safe, never committed)
.scratch/
.vendor-staging/

# Mission capture output — regenerated by scripts/capture-*.mjs on demand, not versioned
docs/visual-reviews/
.tmp/visual-reviews/

# Target-repo sandbox evaluation reports (local, disposable, never committed)
.aigent/

# Dev stack runtime logs + last-exit report (local, disposable, never committed)
.runtime/

# Git worktrees created by tooling — never part of the tree.
.worktrees/

# Generated output of `npm run verify:admin-routes` — regenerated on demand.
tmp/
